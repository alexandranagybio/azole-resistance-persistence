// Educational model of azole-resistance persistence in A. fumigatus.
//
// m1 represents the complete cyp51A TR34/L98H resistance genotype:
// a 34-bp promoter tandem repeat plus the L98H substitution.
// One SLiM mutation is used as an inherited marker for both changes;
// their separate molecular origins are not simulated.
//
// Reference: Mellado et al. (2007), doi:10.1128/AAC.01092-06
//
// Assumptions:
// - 500 clonal haploid individuals; constant population size.
// - Resistance starts in 50 individuals (frequency 0.1).
// - No new mutations, migration, or recombination.
// - Selection coefficient +0.05 during exposure.
// - Selection coefficient -COST after generation 50.
//   COST defaults to 0.05 and can be supplied from the command line.
// - Selection coefficients are illustrative, not measured estimates.
// - Each generation is a model reproductive cycle, not a calendar day.
// - The simulated chromosome and position are abstract;
//   they do not reproduce the physical cyp51A genomic coordinates.

initialize() {
    if (!exists("COST"))
    defineConstant("COST", 0.05);
    initializeMutationType("m1", 1.0, "f", 0.05);
    m1.convertToSubstitution = F;
    initializeGenomicElementType("g1", m1, 1.0);

    initializeChromosome(1, type="H");
    initializeGenomicElement(g1, 0, 99999);
    initializeMutationRate(0.0);
    initializeRecombinationRate(0.0);
}

1 early() {
    sim.addSubpop("p1", 500);
    p1.setCloningRate(1.0);
}

1 late() {
    carriers = sample(p1.individuals, 50);
    allele = carriers[0].haplosomes.addNewDrawnMutation(m1, 50000);
    carriers[1:49].haplosomes.addMutations(allele);

    catn("Starting frequency: " +
        sim.mutationFrequencies(p1, allele));

    writeFile("~/SLiM/changing_exposure.csv",
        "generation,frequency");
    writeFile("~/SLiM/changing_exposure.csv",
        "1,0.1", append=T);
}

50 late() {
    muts = sim.mutationsOfType(m1);
    muts.setSelectionCoeff(-COST);

    catn("Exposure ends: selection coefficient is now " + (-COST));
}

2:100 late() {
    muts = sim.mutationsOfType(m1);

    if (size(muts) == 0)
        freq = 0.0;
    else
        freq = sim.mutationFrequencies(p1, muts);

    catn("Generation " + sim.cycle + ": " + freq);
    writeFile("~/SLiM/changing_exposure.csv",
    sim.cycle + "," + freq, append=T);
}



100 late() {
    catn("Population size: " + p1.individualCount);
    sim.simulationFinished();
}